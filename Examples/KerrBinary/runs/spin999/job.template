#!/bin/bash
#SBATCH --job-name=@NAME@
#SBATCH --account=INF26_teongrav_0
#SBATCH --partition=dcgp_usr_prod
#SBATCH --qos=dcgp_qos_dbg
#SBATCH --nodes=@NODES@
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=7
#SBATCH --time=00:30:00
# runs every directory named in RUNS (default: this one) at once, NPER nodes and NT ranks each
module restore kerrbin_dcgp
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_PLACES=cores OMP_PROC_BIND=close
EXE=$CINECA_SCRATCH/KERR-PROJ-DCGP/spin999/KerrBinary3d.gnu.MPI.OMP.KerrBin.ex
RUNS=${RUNS:-.}; NPER=${NPER:-$SLURM_NNODES}; NT=${NT:-$((16 * NPER))}
for d in $RUNS; do
  (cd $d
   last=$(ls -d checkpoints/chk[0-9]* 2>/dev/null | grep -v temp | sort | tail -1)
   RST=""; if [ -n "$last" ] && [ -f "$last/Header" ]; then RST="amr.restart=$last"; fi
   echo "$d start $(date +%T) restart=${RST:-none}" >> run.log
   srun --exact --gres=none --mem=${MEM:-100G} -N $NPER -n $NT -c 7 --cpu-bind=cores $EXE params.txt $RST >> srun.out 2>&1
   echo "$d end $(date +%T)" >> run.log) &
done
wait
