# flyby_sahf: retrograde flyby of a Schwarzschild hole past a near-extremal Kerr hole, both in the
# Kerr equatorial plane (z = 0, so GRTeclyn can use a reflective z boundary).
# Run (from this directory): kerrbin/build/kerr_binary kerrbin.par
#
# Cartesian components in one frame of your choice (GRTeclyn: origin at geometry.center). The solver
# rotates and shifts so that the holes lie on its z axis and rotates momenta and spins with them.
# All values are bare inputs: the physical masses, spins and momenta are measured afterwards.

[hole A]
# Kerr at rest at the origin, spin +z
mass     = 1.0
position = 0, 0, 0
velocity  = 0, 0, 0
chi       = 0.95
spin_axis = 0, 0, 1
sphere   = 0.8

[hole B]
# Retrograde w.r.t. A's spin: L_z = x v_y - y v_x = -24 x 0.28 < 0, B circles A clockwise seen from +z,
# against A's frame dragging. Same start as runs/flyby (there, with chi_A = 0.9, B swept ~320 deg about A,
# closest coordinate separation 9.5 at t ~ 100). Test-particle estimate about M_tot = 1.5 (a = J_A/M_tot,
# E = gamma sqrt(1 - 2M/d), L = gamma d v_y): periapsis 10.6 retrograde (12.6 prograde), capture below
# L = 6.80, i.e. only ~7% below this L = 7.29; v_y = 0.27 would leave 4%, 0.26 is captured.
mass     = 0.5
position = -24, 0, 0
velocity  = 0.27, 0.28, 0
chi       = 0
spin_axis = 0, 0, 1
sphere   = 0.8

[free data]
weight_power   = 4
metric_falloff = 0

[spectral basis]
p_max = 32
q_max = 32
m_max = 24               # spin perpendicular to the binary axis: m content ~ 3^-m at chi = 0.95

[solver]
tolerance  = 1e-10
max_passes = 20

[horizons]
l_max = 12

[diagnostics]
compare_with = 28, 28, 20   # second solve, max differences in psi, W, M_ADM at probe points

[output]
dir = .
kid = initial_data.kid
phi = 0
